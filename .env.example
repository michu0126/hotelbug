# Default six-service stack replaces the old deployment on port 8098.
WEB_PORT=8098
# Timezone is built into Compose (Asia/Shanghai); no TZ variable is needed.
# Change before production. Use URL-safe characters (e.g. a random hex string).
POSTGRES_PASSWORD=hotelbug-local
# Blank disables management writes; read-only status still works on your LAN.
ADMIN_TOKEN=
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=120
PROVIDER_CONCURRENCY=1
PROVIDER_MIN_INTERVAL_SECONDS=5
SCHEDULER_INTERVAL_SECONDS=10
# Group switches can be saved in the web UI; browser sampling is still being verified.
MARRIOTT_ENABLED=false
IHG_ENABLED=false
HILTON_ENABLED=false
HYATT_ENABLED=false
ACCOR_ENABLED=false
GHA_ENABLED=false
# Per-group optional overrides, e.g. MARRIOTT_CONCURRENCY=1
# MARRIOTT_RATE_LIMIT_SECONDS=5
# Optional Telegram fallback; prefer entering credentials in the web UI.
# Automatic messages are sent only after an independently confirmed low-price event.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BARK_URL=
WEBHOOK_URL=
# For backend development outside Compose:
# DATABASE_URL=postgresql+psycopg://hotelbug:password@localhost:5432/hotelbug
# REDIS_URL=redis://localhost:6379/0
