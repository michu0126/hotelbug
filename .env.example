# Phase 1 framework; use WEB_PORT=8099 while the legacy app occupies 8098.
WEB_PORT=8098
TZ=Asia/Shanghai
# Change before production. Use URL-safe characters (e.g. a random hex string).
POSTGRES_PASSWORD=hotelbug-local
# Blank disables management writes; read-only status still works on your LAN.
ADMIN_TOKEN=
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=120
PROVIDER_CONCURRENCY=1
PROVIDER_MIN_INTERVAL_SECONDS=5
SCHEDULER_INTERVAL_SECONDS=10
# Enabling does not implement an adapter; unsupported jobs still return 409.
MARRIOTT_ENABLED=false
IHG_ENABLED=false
HILTON_ENABLED=false
HYATT_ENABLED=false
ACCOR_ENABLED=false
GHA_ENABLED=false
# Per-group optional overrides, e.g. MARRIOTT_CONCURRENCY=1
# MARRIOTT_RATE_LIMIT_SECONDS=5
# Reserved for Phase 3; notifications are not sent by Phase 1.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BARK_URL=
WEBHOOK_URL=
# For backend development outside Compose:
# DATABASE_URL=postgresql+psycopg://hotelbug:password@localhost:5432/hotelbug
# REDIS_URL=redis://localhost:6379/0
